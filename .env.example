# --- Supabase (Project settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key. Server-side only — never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# --- HousePass server secrets ---
# Signs student/station session cookies. Generate with: openssl rand -hex 32
SESSION_SECRET=
# Bearer token protecting /api/cron/* (late alerts + retention). openssl rand -hex 32
CRON_SECRET=

# --- Email (late alerts) — optional; alerts are logged if unset ---
# https://resend.com API key
RESEND_API_KEY=
# Verified sender, e.g. "HousePass <alerts@school.example>"
ALERT_FROM_EMAIL=

# --- Web Push notifications (students "back soon"/overdue, staff late alerts) ---
# Generate a keypair with:  npx web-push generate-vapid-keys
# The public key is also exposed to the browser (NEXT_PUBLIC_ copy below).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# Contact for push services; any mailto you control.
VAPID_SUBJECT=mailto:alerts@yourschool.example

# --- Behaviour ---
# Days of detailed outing history to keep before the retention job deletes it
RETENTION_DAYS=30
# Minutes before due-back to send the student a "be back soon" reminder
REMIND_BEFORE_MINUTES=10
