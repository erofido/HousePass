# --- Supabase (Project settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Service role key. Server-side only — never exposed to the client.
SUPABASE_SERVICE_ROLE_KEY=

# --- App secrets ---
# The passcode you type to open the app (pick anything you'll remember).
STUDY_PASSCODE=
# Signs the session cookie. Generate with: openssl rand -hex 32
SESSION_SECRET=
# Bearer token protecting /api/cron/* (nags + daily summary). openssl rand -hex 32
# On Vercel, setting CRON_SECRET also makes Vercel Cron authenticate automatically.
CRON_SECRET=

# --- Email (daily summary to your dad) ---
# https://resend.com API key. If unset, summaries are logged, not sent.
RESEND_API_KEY=
# Verified sender, e.g. "Lock In <onboarding@resend.dev>" works out of the box.
SUMMARY_FROM_EMAIL=Lock In <onboarding@resend.dev>

# --- AI Coach (optional but very worth it) ---
# Claude API key from https://platform.claude.com — powers the daily briefing,
# the ask-anything Coach page, personalised nag notifications, and the
# "Coach's verdict" in Dad's nightly email. Leave unset to disable all of it.
ANTHROPIC_API_KEY=

# --- Web Push notifications (the ones that piss you off) ---
# Generate a keypair with:  npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_SUBJECT=mailto:erayfidande@gmail.com
